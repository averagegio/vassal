# Copied automatically by the Vercel Neon integration on deploy.
# For local: `npx vercel env pull .env.local`
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional. If omitted, sessions derive a secret from DATABASE_URL.
SESSION_SECRET=

# X (Twitter) OAuth 2.0 — Developer Portal app credentials
# Callback: https://YOUR_DOMAIN/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional aliases:
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
APP_URL=
